# Example production env (internal LAN)
TZ=America/Bogota
NODE_ENV=production

# DB
POSTGRES_USER=cmms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=cmms
DATABASE_URL=postgresql://cmms:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/cmms?schema=public

# Ports
WEB_PORT=3000
API_PORT=3001

# API
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
# El navegador accede al API mediante /backend en el mismo origen.
# Solo configura API_CORS_ORIGINS si expones el puerto 3001 a otro origen.
API_CORS_ORIGINS=
AUTO_SEED=true
PLATFORM_TENANT_SLUG=platform
PLATFORM_ADMIN_EMAIL=platform-admin@local
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Web
NEXTAUTH_SECRET=CHANGE_ME_STRONG_NEXTAUTH_SECRET
AUTH_TRUST_HOST=true
API_INTERNAL_URL=http://api:3001

# Optional
NEXT_PUBLIC_TENANT_SLUG=platform

# Telegram notifications (optional)
# Add the bot as admin/member of the private channel and use its channel chat id, usually -100...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SERVICE_ORDER_COMMERCIAL_STATUSES=APPROVED,PROGRAMMED
TELEGRAM_TIME_ZONE=America/Bogota
