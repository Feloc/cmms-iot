  replacementServiceOrderPartId String?

  sourceServiceOrder        WorkOrder?         @relation("ServiceOrderPartSourceOrder", fields: [sourceServiceOrderId], references: [id], onDelete: SetNull)
  replacementServiceOrder   WorkOrder?         @relation("ServiceOrderPartReplacementOrder", fields: [replacementServiceOrderId], references: [id], onDelete: SetNull)
