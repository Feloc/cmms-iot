model ServiceOrderPart {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  freeText String?
  qty      Float   @default(1)
  notes    String?

  // REQUIRED: necesario por diagnóstico | REPLACED: repuesto ya cambiado/instalado
  stage            ServiceOrderPartStage @default(REQUIRED)
  replacedAt       DateTime?
  replacedByUserId String?
  replacedByUser   User?                 @relation(fields: [replacedByUserId], references: [id])

  // Vínculos entre repuestos arrastrados, su OS origen y la OS donde se cambiaron.
