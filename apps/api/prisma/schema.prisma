generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SqlMigrationHistory {
  name      String   @id
  appliedAt DateTime @default(now())
}

enum Role {
  ADMIN
  TECH
  VIEWER
}

enum WorkOrderKind {
  WORK_ORDER
  SERVICE_ORDER
}

enum ServiceOrderType {
  ALISTAMIENTO
  DIAGNOSTICO
  PREVENTIVO
  CORRECTIVO
  ENTREGA
  MONTAJE
  OTRO
}

enum AssemblyExecutionStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum AssemblyActivityStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
  NOT_APPLICABLE
}

enum ManufacturingOrderStatus {
  DRAFT
  ENGINEERING
  RELEASED
  ON_HOLD
  CANCELED
}

enum ManufacturedUnitStatus {
  PLANNED
  CANCELED
}

enum ManufacturingMemberFunction {
  RESPONSIBLE
  ENGINEERING
  REVIEWER
  OBSERVER
}

enum EngineeringDiscipline {
  MECHANICAL
  ELECTRICAL
  PNEUMATIC
  HYDRAULIC
  AUTOMATION
  SOFTWARE
  QUALITY
  GENERAL
}

enum EngineeringDocumentType {
  DRAWING
  SCHEMATIC
  SPECIFICATION
  DATASHEET
  PROGRAM
  MANUAL
  CALCULATION
  PROCEDURE
  OTHER
}

enum EngineeringRevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  RELEASED
  OBSOLETE
}

enum ManufacturingBomRevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  RELEASED
  SUPERSEDED
}

enum SupplyType {
  STOCK
  BUY
  MAKE
  SUBCONTRACT
}

enum EngineeringReleaseStatus {
  DRAFT
  RELEASED
  SUPERSEDED
  CANCELED
}

enum ManufacturingSupplyPlanStatus {
  ACTIVE
  SUPERSEDED
  COMPLETED
  CANCELED
}

enum ManufacturingSupplyRequirementStatus {
  OPEN
  IN_PROGRESS
  PARTIAL
  FULFILLED
  CANCELED
}

enum ManufacturingStockReservationStatus {
  ACTIVE
  PARTIAL
  ISSUED
  RELEASED
}

enum ManufacturingSupplyRequestStatus {
  REQUESTED
  IN_PROGRESS
  PARTIAL
  COMPLETED
  CANCELED
}

enum ManufacturingInspectionStatus {
  PENDING
  PARTIAL
  QUARANTINED
  CLOSED
}

enum ManufacturingInspectionDecisionType {
  ACCEPT
  REJECT
  QUARANTINE
  ACCEPT_FROM_QUARANTINE
  REJECT_FROM_QUARANTINE
}

enum ManufacturingKitStatus {
  DRAFT
  PREPARING
  READY
  RELEASED
  CANCELED
}

enum ManufacturingAssemblyExecutionStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum ManufacturingAssemblyOperationStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
  NOT_APPLICABLE
}

// Repuestos en una Orden de Servicio: primero se registran como necesarios (diagnóstico)
// y luego se marcan como cambiados (historial en el activo).
enum ServiceOrderPartStage {
  REQUIRED
  REPLACED
}

enum ServiceOrderIssueNoteStage {
  PENDING
  EXECUTED
}

enum PartType {
  PART
  ASSEMBLY
  KIT
  CONSUMABLE
}

enum PartStatus {
  ACTIVE
  OBSOLETE
  DISCONTINUED
}

enum PartCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
}

enum InventoryMovementSource {
  MANUAL
  IMPORT
  WORK_ORDER
  SERVICE_ORDER
  ADJUSTMENT
  SYSTEM
}

model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Branding opcional para reportes (resumen OS)
  legalName                              String?
  taxId                                  String?
  address                                String?
  phone                                  String?
  email                                  String?
  website                                String?
  logoUrl                                String?
  dashboardWorkHoursPerDay               Float                        @default(8)
  dashboardWorkMonday                    Boolean                      @default(true)
  dashboardWorkMondayStartTime           String                       @default("08:00")
  dashboardWorkMondayEndTime             String                       @default("17:00")
  dashboardWorkMondayMealBreakMinutes    Int                          @default(60)
  dashboardWorkTuesday                   Boolean                      @default(true)
  dashboardWorkTuesdayStartTime          String                       @default("08:00")
  dashboardWorkTuesdayEndTime            String                       @default("17:00")
  dashboardWorkTuesdayMealBreakMinutes   Int                          @default(60)
  dashboardWorkWednesday                 Boolean                      @default(true)
  dashboardWorkWednesdayStartTime        String                       @default("08:00")
  dashboardWorkWednesdayEndTime          String                       @default("17:00")
  dashboardWorkWednesdayMealBreakMinutes Int                          @default(60)
  dashboardWorkThursday                  Boolean                      @default(true)
  dashboardWorkThursdayStartTime         String                       @default("08:00")
  dashboardWorkThursdayEndTime           String                       @default("17:00")
  dashboardWorkThursdayMealBreakMinutes  Int                          @default(60)
  dashboardWorkFriday                    Boolean                      @default(true)
  dashboardWorkFridayStartTime           String                       @default("08:00")
  dashboardWorkFridayEndTime             String                       @default("17:00")
  dashboardWorkFridayMealBreakMinutes    Int                          @default(60)
  dashboardWorkSaturday                  Boolean                      @default(false)
  dashboardWorkSaturdayStartTime         String                       @default("08:00")
  dashboardWorkSaturdayEndTime           String                       @default("17:00")
  dashboardWorkSaturdayMealBreakMinutes  Int                          @default(60)
  dashboardWorkSunday                    Boolean                      @default(false)
  dashboardWorkSundayStartTime           String                       @default("08:00")
  dashboardWorkSundayEndTime             String                       @default("17:00")
  dashboardWorkSundayMealBreakMinutes    Int                          @default(60)
  dashboardExcludeNonWorkingDates        Boolean                      @default(false)
  dashboardNonWorkingDates               String[]                     @default([])
  users                                  User[]
  assets                                 Asset[]
  rules                                  Rule[]
  alerts                                 Alert[]
  notices                                Notice[]
  workOrders                             WorkOrder[]
  assignments                            WOAssignment[]
  serviceOrderParts                      ServiceOrderPart[]
  serviceOrderIssueNotes                 ServiceOrderIssueNote[]
  workLog                                WorkLog[]
  inventory                              InventoryItem[]
  inventoryApplicabilities               InventoryItemApplicability[]
  inventoryStocks                        InventoryStock[]
  inventoryMovements                     InventoryMovement[]
  partsManuals                           PartsManual[]
  partsManualPages                       PartsManualPage[]
  partsManualHotspots                    PartsManualHotspot[]
  createdAt                              DateTime                     @default(now())
  updatedAt                              DateTime                     @updatedAt

  symptomCodes                 SymptomCode[]
  causeCodes                   CauseCode[]
  remedyCodes                  RemedyCode[]
  workOrderResolutions         WorkOrderResolution[]
  workOrderPartUses            WorkOrderPartUsed[]
  workMeasurements             WorkMeasurement[]
  assetMeterReadings           AssetMeterReading[]
  serviceOrderIssues           ServiceOrderIssue[]
  serviceOrderCommercialNotes  ServiceOrderCommercialNote[]
  attachments                  Attachment[]
  workNotes                    WorkNote[]
  assetImportUploads           AssetImportUpload[]
  devices                      Device[]
  ruleStates                   RuleState[]
  assetEvents                  AssetEvent[]
  pmPlans                      PmPlan[]
  assetMaintenancePlans        AssetMaintenancePlan[]
  preventiveMaintenanceRecords AssetPreventiveMaintenance[]
  goals                        Goal[]
  assemblyTemplates            AssemblyTemplate[]
  assemblyTemplateSteps        AssemblyTemplateStep[]
  assemblyExecutions           AssemblyExecution[]
  assemblyActivities           AssemblyActivity[]
  assemblyScheduleRevisions    AssemblyScheduleRevision[]
  assemblyOperationalAlerts    AssemblyOperationalAlert[]
  manufacturingNumberSequences ManufacturingNumberSequence[]
  manufacturingOrders          ManufacturingOrder[]
  manufacturedUnits            ManufacturedUnit[]
  manufacturingOrderMembers    ManufacturingOrderMember[]
  manufacturingAuditEvents     ManufacturingAuditEvent[]
  engineeringDocuments         EngineeringDocument[]
  engineeringDocumentRevisions EngineeringDocumentRevision[]
  manufacturingBoms            ManufacturingBom[]
  manufacturingBomRevisions    ManufacturingBomRevision[]
  manufacturingBomLines        ManufacturingBomLine[]
  engineeringReleases          EngineeringRelease[]
  engineeringReleaseDocuments  EngineeringReleaseDocument[]
  manufacturingSupplyPlans     ManufacturingSupplyPlan[]
  manufacturingSupplyRequirements ManufacturingSupplyRequirement[]
  manufacturingStockReservations ManufacturingStockReservation[]
  manufacturingSupplyRequests ManufacturingSupplyRequest[]
  manufacturingSupplyDeliveries ManufacturingSupplyDelivery[]
  manufacturingInspectionDecisions ManufacturingInspectionDecision[]
  manufacturingKits ManufacturingKit[]
  manufacturingKitLines ManufacturingKitLine[]
  manufacturingAssemblyExecutions ManufacturingAssemblyExecution[]
  manufacturingAssemblyOperations ManufacturingAssemblyOperation[]
  manufacturingAssemblyTimeLogs ManufacturingAssemblyTimeLog[]
  manufacturingAssemblyEvidence ManufacturingAssemblyEvidence[]
  manufacturingAssemblyConsumptions ManufacturingAssemblyConsumption[]

  workOrderReports WorkOrderReport[]
}

model Goal {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  metric String
  period String
  target Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, metric, period])
  @@index([tenantId, metric, period])
}

enum WorkOrderReportAudience {
  CUSTOMER
  INTERNAL
}

model WorkOrderReport {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  audience WorkOrderReportAudience
  version  Int

  // Snapshot (inmutable) del reporte al momento de generar
  data Json

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([tenantId, workOrderId, audience, version])
  @@index([tenantId, workOrderId, audience])
  @@index([tenantId, createdAt])
}

model User {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  email       String
  password    String
  authVersion Int      @default(0)
  role        Role     @default(ADMIN)
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments                    WOAssignment[]
  serviceOrderParts              ServiceOrderPart[]
  assetMeterReadings             AssetMeterReading[]
  preventiveMaintenanceRecords   AssetPreventiveMaintenance[]
  manufacturingOrdersResponsible ManufacturingOrder[]         @relation("ManufacturingOrderResponsible")
  manufacturingOrdersCreated     ManufacturingOrder[]         @relation("ManufacturingOrderCreatedBy")
  manufacturingOrderMemberships  ManufacturingOrderMember[]

  @@unique([tenantId, email])
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
}

model Asset {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code             String
  name             String
  customer         String?
  brand            String?
  model            String?
  serialNumber     String?
  nominalPower     Float?
  nominalPowerUnit String?

  status      AssetStatus      @default(ACTIVE)
  criticality AssetCriticality @default(MEDIUM)

  categoryId    String?
  parentAssetId String?
  locationId    String?
  supplierId    String?

  slug             String?
  barcode          String?
  qrCodeData       String?
  ingestKey        String?
  assetTopicPrefix String?
  defaultRuleSetId String?

  acquiredOn        DateTime?
  guarantee         DateTime?
  latestHourmeter   Float?
  latestHourmeterAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attachments                  Attachment[]
  devices                      Device[]
  rules                        Rule[]
  assetEvents                  AssetEvent[]
  maintenancePlan              AssetMaintenancePlan?
  meterReadings                AssetMeterReading[]
  preventiveMaintenanceRecords AssetPreventiveMaintenance[]
  manufacturedUnit             ManufacturedUnit?

  @@unique([tenantId, code])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, name])
  @@index([tenantId, locationId])
  @@index([tenantId, categoryId])
  @@index([tenantId, parentAssetId])
}

// Modelo para almacenar uploads temporales de importación de Assets
model AssetImportUpload {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  originalName String
  mimeType     String
  size         Int
  sha256       String
  storagePath  String
  status       ImportStatus @default(PENDING)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([tenantId, createdAt])
}

enum ImportStatus {
  PENDING
  COMMITTED
  EXPIRED
  FAILED
}

model Alert {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  assetCode String
  sensor    String
  kind      String // THRESHOLD | ROC
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notices   Notice[]

  @@index([tenantId, assetCode, sensor])
}

model Notice {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  source  NoticeSource
  alertId String?
  alert   Alert?       @relation(fields: [alertId], references: [id])

  assetCode String
  title     String
  body      String?
  category  NoticeCategory?
  severity  Severity?
  status    NoticeStatus    @default(OPEN)

  createdByUserId  String
  assignedToUserId String?
  dueDate          DateTime?
  startedAt        DateTime?
  resolvedAt       DateTime?
  downtimeMin      Int?
  tags             String[]  @default([])
  attachments      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders WorkOrder[]

  @@index([tenantId, status])
  @@index([tenantId, assetCode, status])
  @@index([tenantId, createdAt])
}

enum NoticeSource {
  RULE
  MANUAL
  IMPORT
}

enum NoticeCategory {
  INCIDENT
  MAINT_LOG
  CONSUMABLE_CHANGE
  INSPECTION
  OTHER
}

enum NoticeStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WorkOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  noticeId String?
  notice   Notice? @relation(fields: [noticeId], references: [id])

  assetCode        String
  title            String
  description      String?
  status           WorkOrderStatus               @default(OPEN)
  commercialStatus ServiceOrderCommercialStatus?
  priority         WorkOrderPriority?

  kind                        WorkOrderKind               @default(WORK_ORDER)
  serviceOrderType            ServiceOrderType?
  pmPlanId                    String?
  pmPlan                      PmPlan?                     @relation(fields: [pmPlanId], references: [id])
  preventiveMaintenanceRecord AssetPreventiveMaintenance?

  hasIssue Boolean @default(false)
  formData Json?

  takenAt            DateTime?
  arrivedAt          DateTime?
  checkInAt          DateTime?
  activityStartedAt  DateTime?
  activityFinishedAt DateTime?
  deliveredAt        DateTime?

  technicianSignature String?
  receiverSignature   String?
  dueDate             DateTime?
  durationMin         Int?      @default(60)
  startedAt           DateTime?
  completedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments                          WOAssignment[]
  serviceOrderParts                    ServiceOrderPart[]
  sourceLinkedServiceOrderParts        ServiceOrderPart[]           @relation("ServiceOrderPartSourceOrder")
  replacementLinkedServiceOrderParts   ServiceOrderPart[]           @relation("ServiceOrderPartReplacementOrder")
  serviceOrderIssueNotes               ServiceOrderIssueNote[]
  sourceLinkedServiceOrderIssueNotes   ServiceOrderIssueNote[]      @relation("ServiceOrderIssueNoteSourceOrder")
  executedLinkedServiceOrderIssueNotes ServiceOrderIssueNote[]      @relation("ServiceOrderIssueNoteExecutedOrder")
  workLogs                             WorkLog[]
  reports                              WorkOrderReport[]
  workOrderResolutions                 WorkOrderResolution[]
  workOrderPartUses                    WorkOrderPartUsed[]
  workMeasurements                     WorkMeasurement[]
  meterReadings                        AssetMeterReading[]
  serviceOrderIssue                    ServiceOrderIssue?
  commercialNotes                      ServiceOrderCommercialNote[]
  attachments                          Attachment[]
  workNotes                            WorkNote[]
  assemblyExecution                    AssemblyExecution?

  @@index([tenantId, status])
  @@index([tenantId, commercialStatus])
  @@index([tenantId, assetCode, status])
}

enum WorkOrderStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CLOSED
  CANCELED
}

enum ServiceOrderCommercialStatus {
  NO_MANAGEMENT
  PENDING_QUOTE
  PENDING_APPROVAL
  NOT_APPROVED
  APPROVED
  PROGRAMMED
  CONFIRMED
  COMPLETED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceOrderIssueStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  VERIFIED
  CANCELED
}

model ServiceOrderIssue {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  status             ServiceOrderIssueStatus @default(OPEN)
  openedAt           DateTime                @default(now())
  openedByUserId     String?
  ownerUserId        String?
  targetResolutionAt DateTime?
  lastFollowUpAt     DateTime?
  followUpNote       String?

  resolutionSummary     String?
  resolutionWorkOrderId String?
  resolvedAt            DateTime?
  resolvedByUserId      String?

  verifiedAt        DateTime?
  verifiedByUserId  String?
  verificationNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, updatedAt(sort: Desc)])
  @@index([tenantId, ownerUserId, status])
  @@index([tenantId, resolutionWorkOrderId])
}

model WOAssignment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  userId String
  user   User?           @relation(fields: [userId], references: [id])
  role   AssignmentRole  @default(TECHNICIAN)
  state  AssignmentState @default(ACTIVE)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, workOrderId, state])
  @@index([tenantId, userId, state])
}

enum AssignmentRole {
  TECHNICIAN
  SUPERVISOR
}

enum AssignmentState {
  ACTIVE
  REMOVED
}

model WorkLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  assemblyActivityId String?
  assemblyActivity   AssemblyActivity? @relation(fields: [assemblyActivityId], references: [id], onDelete: SetNull)

  userId String
  source WorkLogSource @default(MANUAL)
  note   String?

  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, workOrderId])
  @@index([tenantId, assemblyActivityId])
  @@index([tenantId, userId, startedAt])
}

enum WorkLogSource {
  MANUAL
  IMPORT
  IOT
}

model AssemblyTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  brand       String?
  model       String?
  version     Int     @default(1)
  active      Boolean @default(true)

  steps      AssemblyTemplateStep[]
  executions AssemblyExecution[]
  manufacturingExecutions ManufacturingAssemblyExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code, version])
  @@index([tenantId, active, name])
}

model AssemblyTemplateStep {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  templateId         String
  template           AssemblyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position           Int
  phase              String?
  name               String
  instructions       String?
  estimatedMinutes   Int
  plannedTechnicians Int              @default(1)
  dependsOnPositions Json             @default("[]")
  required           Boolean          @default(true)
  evidenceRequired   Boolean          @default(false)

  activities AssemblyActivity[]
  manufacturingOperations ManufacturingAssemblyOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, position])
  @@index([tenantId, templateId, position])
}

model AssemblyExecution {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workOrderId         String                  @unique
  workOrder           WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  templateId          String?
  template            AssemblyTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateCode        String
  templateName        String
  templateVersion     Int
  status              AssemblyExecutionStatus @default(PLANNED)
  plannedMinutes      Int
  plannedLaborMinutes Int
  scheduledStartAt    DateTime?
  scheduleTimezone    String                  @default("America/Bogota")
  workdayStartMinute  Int                     @default(480)
  workdayEndMinute    Int                     @default(1020)
  workingDays         Json                    @default("[1,2,3,4,5]")
  excludedDates       Json                    @default("[]")
  scheduleVersion     Int                     @default(1)
  startedAt           DateTime?
  completedAt         DateTime?

  activities        AssemblyActivity[]
  scheduleRevisions AssemblyScheduleRevision[]
  operationalAlerts AssemblyOperationalAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, updatedAt(sort: Desc)])
  @@index([tenantId, templateId])
}

model AssemblyScheduleRevision {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  executionId     String
  execution       AssemblyExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  version         Int
  reason          String
  createdByUserId String
  createdByName   String
  baselineStartAt DateTime
  baselineEndAt   DateTime
  snapshot        Json
  createdAt       DateTime          @default(now())

  @@unique([executionId, version])
  @@index([tenantId, executionId, createdAt(sort: Desc)])
}

model AssemblyActivity {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  executionId        String
  execution          AssemblyExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  templateStepId     String?
  templateStep       AssemblyTemplateStep?  @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  position           Int
  phase              String?
  name               String
  instructions       String?
  estimatedMinutes   Int
  plannedTechnicians Int                    @default(1)
  dependsOnPositions Json                   @default("[]")
  required           Boolean                @default(true)
  evidenceRequired   Boolean                @default(false)
  status             AssemblyActivityStatus @default(PENDING)
  progressPercent    Int                    @default(0)
  assignedUserId     String?
  notes              String?
  blockedReason      String?
  startedAt          DateTime?
  completedAt        DateTime?
  completedByUserId  String?

  workLogs          WorkLog[]
  attachments       Attachment[]               @relation("AssemblyActivityAttachments")
  operationalAlerts AssemblyOperationalAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([executionId, position])
  @@index([tenantId, executionId, position])
  @@index([tenantId, status])
}

model AssemblyOperationalAlert {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  executionId String
  execution   AssemblyExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    AssemblyActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  fingerprint        String    @unique
  code               String
  severity           String
  status             String    @default("OPEN")
  message            String
  assignedUserId     String?
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  acknowledgedByName String?
  resolvedAt         DateTime?
  firstDetectedAt    DateTime  @default(now())
  lastDetectedAt     DateTime  @default(now())
  escalationLevel    Int       @default(0)
  escalatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

