  delegatedParts            ServiceOrderPart[] @relation("ServiceOrderPartSource")
  replacementPart           ServiceOrderPart?  @relation("ServiceOrderPartReplacement", fields: [replacementServiceOrderPartId], references: [id], onDelete: SetNull)
  reflectedReplacementParts ServiceOrderPart[] @relation("ServiceOrderPartReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, workOrderId])
  @@index([tenantId, stage])
  @@index([tenantId, sourceServiceOrderId])
  @@index([tenantId, sourceServiceOrderPartId])
  @@index([tenantId, replacementServiceOrderId])
  @@index([tenantId, replacementServiceOrderPartId])
}

